# Configurações do LightRag
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
#AGE_GRAPH_NAME="rag"

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD="XXXXXXX"
POSTGRES_DATABASE=lightrag
POSTGRES_MAX_CONNECTIONS=12

# LLM/Embedding via OpenAI direto
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_API_KEY=sk-or-v1-xxxxxxx
LLM_BINDING_HOST=https://openrouter.ai/api/v1

EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BINDING_API_KEY=sk-or-v1-xxxxxxx
EMBEDDING_DIM=1536

# Autenticação completa
AUTH_ACCOUNTS=admin:admin_pass,user:user_pass
TOKEN_SECRET=xxxxxxxxxx
TOKEN_EXPIRE_HOURS=24

# API Key para automação/API
LIGHTRAG_API_KEY=xxxxxxxxxx

# Paths que NÃO precisam de login
WHITELIST_PATHS=/health

# Redis para cache
#REDIS_URL="redis://:J40geW0tC8VoaUqoZ@redis:6379/3"

#Configurações do Postgres
POSTGRES_DB=lightrag